name: Release

on:
  push:
    tags:
      - "v*"

permissions:
  contents: write

jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Grant wrapper
        run: chmod +x gradlew scripts/fetch-stockfish.sh

      - name: Fetch Stockfish binary
        run: ./scripts/fetch-stockfish.sh

      - name: Decode release keystore
        env:
          SIGNING_KEYSTORE_BASE64: ${{ secrets.SIGNING_KEYSTORE_BASE64 }}
        run: |
          set -euo pipefail
          echo "$SIGNING_KEYSTORE_BASE64" | base64 -d > "$RUNNER_TEMP/just-chess-release.p12"
          echo "SIGNING_STORE_FILE=$RUNNER_TEMP/just-chess-release.p12" >> "$GITHUB_ENV"

      - name: Assemble signed release APK
        env:
          SIGNING_STORE_PASSWORD: ${{ secrets.SIGNING_STORE_PASSWORD }}
          SIGNING_KEY_ALIAS: ${{ secrets.SIGNING_KEY_ALIAS }}
          SIGNING_KEY_PASSWORD: ${{ secrets.SIGNING_KEY_PASSWORD }}
        run: ./gradlew :app:assembleRelease --stacktrace

      - name: Check merged manifest has no INTERNET
        run: |
          set -e
          f=$(find app/build/intermediates/merged_manifests/release -name AndroidManifest.xml | head -n 1)
          echo "Checking $f"
          if grep -E 'android:name="android.permission.INTERNET"' "$f" | grep -v 'tools:node="remove"'; then
            echo "INTERNET permission found in merged manifest" >&2
            cat "$f"
            exit 1
          fi
          echo "OK: no INTERNET permission"

      - name: Stage APK asset
        id: apk
        run: |
          set -euo pipefail
          src=$(ls app/build/outputs/apk/release/*-release.apk | head -n 1)
          ver="${GITHUB_REF_NAME#v}"
          out="just-chess-${ver}.apk"
          cp "$src" "$out"
          echo "name=$out" >> "$GITHUB_OUTPUT"
          ls -la "$out"
          sha256sum "$out"

      - name: Create GitHub Release
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          gh release create "$GITHUB_REF_NAME" \
            "${{ steps.apk.outputs.name }}" \
            --title "Just Chess ${GITHUB_REF_NAME}" \
            --notes "Offline GrapheneOS chess (arm64). Sideload the APK; Graphene will warn it is not Play-signed. Optional: Obtainium → https://github.com/pudgyturtle/just-chess"
